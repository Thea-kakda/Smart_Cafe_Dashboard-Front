# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Base URL of the Smart Coffee backend API.
# Leave EMPTY (default) to call the backend same-origin through the Vite dev
# proxy (proxied to VITE_PROXY_TARGET, default http://localhost:8080).
# The httpOnly refresh_token cookie requires same-origin requests; set this
# to an absolute URL only when the backend CORS configuration allows the
# dashboard origin.
VITE_API_BASE_URL=""

# VITE_PROXY_TARGET: Target backend used by the Vite dev server proxy in
# vite.config.ts (development only).
# Use the IPv4 literal 127.0.0.1, NOT "localhost": on Windows Node 17+ resolves
# "localhost" to ::1 (IPv6) first, but the Spring Boot backend binds IPv4-only
# (0.0.0.0:8080), so "localhost" yields ECONNREFUSED / 502 Bad Gateway.
VITE_PROXY_TARGET="http://127.0.0.1:8080"
